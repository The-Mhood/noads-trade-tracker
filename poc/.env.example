# Copy to poc/.env.local and fill in. poc/.env.local is git-ignored.
# NEVER put live or prop-firm credentials here — DEMO accounts only.
# Used by the guarded POC-1 runner (poc/poc1-runner.mjs) and the POC-2 receiver.

# --- MetaApi provider ---
METAAPI_TOKEN=
# Approved hosts only; the adapter rejects anything else. Examples:
#   https://mt-provisioning-api-v1.agiliumtrade.ai
#   https://mt-client-api-v1.new-york.agiliumtrade.ai   (region of the account)
METAAPI_PROVISIONING_HOST=
METAAPI_TRADE_HOST=

# --- Exact pre-existing MT5 demo account (the runner has no create/deploy path) ---
POC_APPROVED_ACCOUNT_ID=
MT_LOGIN=
# MT_PASSWORD is not read by the guarded runner (token-based); keep it only if a
# separately approved workflow needs it. Never commit real values.
MT_PASSWORD=
MT_SERVER=MetaQuotes-Demo
MT_PLATFORM=mt5
MT_SYMBOL=XAUUSD

# --- POC-1 runner guards ---
# Independently verified broker UTC offset in whole minutes (e.g. UTC+3 demo server = 180).
# Must be a strict integer string; empty or malformed blocks every run.
POC_BROKER_OFFSET_MINUTES=
# Per-order POC downside risk guard in USD; must satisfy 0 < n <= 10.
POC_RISK_USD=10

# --- POC-2 webhook receiver ---
WEBHOOK_TOKEN=

# Legacy variable, read only by the locked historical harness (metaapi-exec.mjs):
RISK_USD=10
